<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Proposta GranRio</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{--azul:#1858b0;--azul-esc:#0f3c7a;--verm:#cb3326;--verm-esc:#a3271c;--graf:#15202e;--graf2:#243243;--cinza:#5a6573;
    --linha:#e1e6ee;--nevoa:#f3f5f9;--ok:#1f9d55;--r:12px}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{font-family:'Inter',system-ui,sans-serif;font-size:14px;color:var(--graf);background:#fff;-webkit-font-smoothing:antialiased}
  button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
  #app{display:flex;flex-direction:column;min-height:100%}
  .tri{height:4px;display:flex}.tri i{flex:1}.tri i:nth-child(1){background:var(--verm)}.tri i:nth-child(2){background:#fff}.tri i:nth-child(3){background:var(--azul)}
  header.top{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--linha)}
  .top-row{display:flex;align-items:center;justify-content:space-between;padding:10px 14px 4px;gap:10px}
  .brand{display:flex;align-items:center;gap:8px;font-family:'Bricolage Grotesque','Inter',system-ui,sans-serif;font-weight:800;font-size:16px}
  .brand img{width:26px;height:26px;border-radius:50%}
  .brand b{color:var(--azul)}.brand span{color:var(--verm)}.brand small{font-family:'Inter',system-ui,sans-serif;font-weight:500;font-size:12px;color:var(--cinza)}
  .num{font-size:11.5px;color:var(--cinza);font-variant-numeric:tabular-nums}
  .who{padding:0 14px 8px;font-size:12.5px;color:var(--cinza);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .who strong{color:var(--graf)}
  .steps{display:flex;gap:2px;padding:0 10px 8px}
  .step{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;padding:7px 2px;border:none;background:none;border-radius:8px;
    font-size:12px;font-weight:600;color:var(--cinza);cursor:pointer}
  .step i{font-style:normal;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-size:10.5px;background:var(--nevoa);color:var(--cinza)}
  .step.on{color:var(--azul);background:#edf3fc}.step.on i{background:var(--azul);color:#fff}
  .step.ok i{background:#dcefe3;color:var(--ok)}
  main{flex:1;padding:14px 14px 110px}
  h2.t{font-family:'Bricolage Grotesque',sans-serif;font-size:19px;font-weight:800;margin-bottom:4px}
  p.sub{color:var(--cinza);font-size:13px;margin-bottom:14px}
  .fld{margin-bottom:12px}
  .fld label,.lbl{display:block;font-size:12px;font-weight:600;color:var(--graf2);margin-bottom:5px}
  .i{width:100%;padding:10px 11px;border:1.5px solid var(--linha);border-radius:10px;background:#fbfcfe;transition:border-color .15s,box-shadow .15s}
  .i:focus{outline:none;border-color:var(--azul);box-shadow:0 0 0 3px rgba(24,88,176,.12)}
  textarea.i{resize:vertical;line-height:1.45}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .hint{font-size:11.5px;color:var(--cinza);margin-top:4px}
  .seg{display:flex;background:var(--nevoa);border-radius:10px;padding:3px;gap:3px}
  .seg button{flex:1;border:none;background:none;padding:8px 6px;border-radius:8px;font-weight:600;font-size:12.5px;color:var(--cinza);cursor:pointer}
  .seg button.on{background:#fff;color:var(--azul);box-shadow:0 1px 4px rgba(21,32,46,.1)}
  .chips{display:flex;flex-wrap:wrap;gap:6px}
  .chips.scroll{flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px;margin:0 -14px;padding-left:14px;padding-right:14px;scrollbar-width:thin}
  .chips.scroll .chip{flex:none}
  .chip{border:1.5px solid var(--linha);background:#fff;border-radius:999px;padding:6px 11px;font-size:12.5px;font-weight:500;cursor:pointer;color:var(--graf2)}
  .chip.on{background:var(--azul);border-color:var(--azul);color:#fff}
  .card{border:1px solid var(--linha);border-radius:var(--r);padding:12px;margin-bottom:12px;background:#fff}
  .card h3{font-size:13px;font-weight:700;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
  .card h3 small{font-weight:500;color:var(--cinza)}
  /* itens da proposta */
  .sel-it{display:grid;grid-template-columns:1fr auto;gap:6px 8px;padding:9px 0;border-top:1px solid var(--linha)}
  .sel-it:first-of-type{border-top:none;padding-top:2px}
  .sel-it .nm{font-weight:600;font-size:13px}
  .sel-it .nm input{font-weight:600}
  .sel-it .x{border:none;background:none;color:var(--cinza);font-size:18px;cursor:pointer;line-height:1;padding:0 2px}
  .sel-it .x:hover{color:var(--verm)}
  .sel-it .ctl{grid-column:1/-1;display:grid;grid-template-columns:118px 1fr auto;gap:8px;align-items:center}
  .stp{display:flex;align-items:center;border:1.5px solid var(--linha);border-radius:10px;overflow:hidden}
  .stp button{width:32px;height:34px;border:none;background:var(--nevoa);font-size:17px;font-weight:700;color:var(--azul);cursor:pointer}
  .stp input{width:100%;min-width:0;border:none;text-align:center;font-weight:600;height:34px;background:#fff}
  .stp input:focus{outline:none}
  .pr{display:flex;align-items:center;border:1.5px solid var(--linha);border-radius:10px;padding:0 9px;height:37px;background:#fbfcfe}
  .pr span{font-size:12px;color:var(--cinza);margin-right:4px}
  .pr input{border:none;background:none;width:100%;min-width:0;font-weight:600}
  .pr input:focus{outline:none}
  .pr.alt{border-color:#e9b949;background:#fffaf0}
  .stt{font-weight:700;font-size:13px;text-align:right;min-width:78px;font-variant-numeric:tabular-nums}
  .warn{grid-column:1/-1;font-size:11.5px;color:var(--verm-esc)}
  .empty{text-align:center;color:var(--cinza);font-size:13px;padding:14px 6px}
  /* catálogo */
  .busca{position:relative;margin-bottom:8px}
  .busca input{padding-left:34px}
  .busca svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--cinza)}
  .grp{margin:14px 0 4px;font-size:11.5px;font-weight:700;color:var(--verm);letter-spacing:.02em}
  .prod{display:flex;align-items:center;gap:10px;padding:9px 2px;border-bottom:1px solid var(--linha)}
  .prod .inf{flex:1;min-width:0}
  .prod .inf b{display:block;font-size:13px;font-weight:600}
  .prod .inf span{font-size:12px;color:var(--cinza);font-variant-numeric:tabular-nums}
  .add{border:1.5px solid var(--azul);background:#fff;color:var(--azul);border-radius:9px;padding:6px 11px;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap}
  .add:hover{background:#edf3fc}
  .add.in{background:var(--azul);color:#fff}
  .btn-sm{border:1.5px dashed var(--linha);background:#fff;border-radius:10px;padding:9px;width:100%;font-weight:600;color:var(--azul);cursor:pointer;margin-top:8px}
  /* barra */
  .bar{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--linha);padding:10px 14px;box-shadow:0 -6px 18px rgba(21,32,46,.06);z-index:6}
  .bar .tot{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;font-size:12px;color:var(--cinza)}
  .bar .tot b{font-size:18px;color:var(--graf);font-variant-numeric:tabular-nums}
  .bar .acts{display:flex;gap:8px}
  .b{flex:1;border:none;border-radius:10px;padding:11px 10px;font-weight:700;cursor:pointer;font-size:14px}
  .b.pri{background:var(--azul);color:#fff}.b.pri:hover{background:var(--azul-esc)}
  .b.sec{background:var(--nevoa);color:var(--graf2);flex:0 0 auto;padding:11px 14px}
  .b.wpp{background:#25d366;color:#fff}
  .b[disabled]{opacity:.6;cursor:progress}
  .resumo div{display:flex;justify-content:space-between;gap:10px;padding:5px 0;font-size:13px}
  .resumo div span{color:var(--cinza)}
  .resumo div b{text-align:right;font-variant-numeric:tabular-nums}
  .resumo .big{border-top:1px solid var(--linha);margin-top:4px;padding-top:9px}
  .resumo .big b{font-size:17px;color:var(--azul)}
  .chk{display:flex;gap:9px;align-items:flex-start;font-size:13px;cursor:pointer;margin:6px 0}
  .chk input{margin-top:2px;accent-color:var(--azul);width:16px;height:16px}
  .center{padding:60px 22px;text-align:center}
  .center h2{font-family:'Bricolage Grotesque',sans-serif;font-size:19px;margin-bottom:8px}
  .center p{color:var(--cinza);margin-bottom:14px}
  .st{list-style:none;margin:10px 0 14px}
  .st li{display:flex;gap:8px;padding:6px 0;font-size:13px;border-bottom:1px solid var(--linha)}
  .st li.ok::before{content:'✓';color:var(--ok);font-weight:800}
  .st li.no::before{content:'✕';color:var(--verm);font-weight:800}
  .okbig{width:62px;height:62px;border-radius:50%;background:#e7f6ec;color:var(--ok);display:grid;place-items:center;font-size:30px;font-weight:800;margin:10px auto 14px}
  .lnk{word-break:break-all;font-size:12px;color:var(--azul)}
  .aviso{background:#fdf1ef;color:var(--verm-esc);border-radius:10px;padding:10px 12px;font-size:13px;margin-bottom:12px}
  /* modal pdf */
  .mod{position:fixed;inset:0;z-index:20;background:rgba(21,32,46,.6);display:none;flex-direction:column}
  .mod.on{display:flex}
  .mod-h{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:10px 12px;gap:8px}
  .mod-h b{font-size:14px}
  .mod-h .acts{display:flex;gap:6px}
  .mod iframe{flex:1;border:0;background:#525659;width:100%}
  .toast{position:fixed;left:50%;bottom:120px;transform:translateX(-50%) translateY(20px);background:var(--graf);color:#fff;padding:9px 14px;border-radius:10px;font-size:13px;opacity:0;transition:.25s;pointer-events:none;z-index:30;max-width:90%}
  .toast.on{opacity:1;transform:translateX(-50%)}
  :focus-visible{outline:2px solid var(--azul);outline-offset:2px}
</style>
</head>
<body>
<div id="app"></div>
<div class="mod" id="mod" role="dialog" aria-modal="true" aria-label="Prévia do PDF">
  <div class="mod-h"><b>Prévia da proposta</b><div class="acts"><button class="b sec" id="mBaixar">Baixar</button><button class="b sec" id="mFechar">Fechar</button></div></div>
  <iframe id="mFrame" title="Prévia do PDF"></iframe>
</div>
<div class="toast" id="toast" role="status"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/vfs_fonts.min.js"></script>
<script>
var LOGO_PDF = 'data:image/png;base64,';
/* ===== Montagem do PDF (pdfmake) — GranRio ===== */
var COR = { azul: '#1858b0', azulEsc: '#0f3c7a', verm: '#cb3326', graf: '#15202e', cinza: '#5a6573', linha: '#dfe4ec', nevoa: '#f3f5f9', zebra: '#f7f9fc' };
function brl(v) { return Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
function qtdTxt(v) { return Number(v || 0).toLocaleString('pt-BR') + ' un.'; }
function dataBR(d) { return d.toLocaleDateString('pt-BR'); }
function calcular(p) {
  var sub = 0;
  (p.itens || []).forEach(function (it) { sub += (Number(it.qtd) || 0) * (Number(it.preco) || 0); });
  sub = Math.round(sub * 100) / 100;
  var dv = Number(p.desconto.valor) || 0;
  var desc = p.desconto.tipo === 'pct' ? sub * Math.min(dv, 100) / 100 : Math.min(dv, sub);
  desc = Math.round(desc * 100) / 100;
  var frete = p.frete.tipo === 'cobrado' ? (Number(p.frete.valor) || 0) : 0;
  var total = Math.round((sub - desc + frete) * 100) / 100;
  var un = (p.itens || []).reduce(function (a, it) { return a + (Number(it.qtd) || 0); }, 0);
  return { sub: sub, desc: desc, frete: frete, total: total, unidades: un };
}
function validadeData(p) { var d = new Date(p.data); d.setDate(d.getDate() + (Number(p.validadeDias) || 7)); return d; }
function textoFrete(p) {
  return ({ cif: 'Frete grátis (CIF), entrega por conta da GranRio', retirada: 'Retirada na fábrica, em São João de Meriti — RJ',
    cobrado: 'Frete de ' + brl(p.frete.valor) + ', já incluído no total', combinar: 'A combinar' })[p.frete.tipo] || 'A combinar';
}
function textoPagamento(p) {
  var f = (p.pagamento || []).slice();
  var i = f.indexOf('Faturado');
  if (i > -1) f[i] = 'Faturado em ' + (p.prazoFaturado || '28 dias');
  if (!f.length) return 'A combinar';
  return f.length === 1 ? f[0] : f.slice(0, -1).join(', ') + ' ou ' + f[f.length - 1];
}

function montarDoc(p, E, LOGO) {
  var t = calcular(p), cl = p.cliente, emissao = new Date(p.data);

  var cab = {
    columnGap: 16,
    columns: [
      LOGO ? { image: LOGO, width: 58 } : { text: '', width: 0 },
      { width: '*', margin: [0, 6, 0, 0], stack: [
        { text: E.razao || 'GranRio', fontSize: 10.5, bold: true, color: COR.graf },
        { text: E.cnpj ? 'CNPJ ' + E.cnpj : '', fontSize: 8.5, color: COR.cinza, margin: [0, 3, 0, 0] },
        { text: E.slogan || '', fontSize: 8.5, color: COR.azul, margin: [0, 2, 0, 0] }
      ] },
      { width: 170, alignment: 'right', margin: [0, 4, 0, 0], stack: [
        { text: 'PROPOSTA COMERCIAL', fontSize: 9, bold: true, color: COR.verm, characterSpacing: 1 },
        { text: 'Nº ' + p.numero, fontSize: 13, bold: true, color: COR.graf, margin: [0, 3, 0, 4] },
        { text: 'Emitida em ' + dataBR(emissao), fontSize: 8.5, color: COR.cinza },
        { text: 'Válida até ' + dataBR(validadeData(p)), fontSize: 8.5, color: COR.cinza }
      ] }
    ]
  };

  function par(rot, val) { return val ? [{ text: rot, style: 'rot' }, { text: val, style: 'val' }] : null; }
  function cel(rot, val) { return val ? { stack: [{ text: rot, style: 'rot' }, { text: val, style: 'val', bold: rot === 'Cliente', margin: [0, 1, 0, 6] }] } : null; }
  var esq = [cel('Cliente', cl.nome || cl.responsavel), cel('CNPJ / CPF', cl.doc), cel('Responsável', cl.nome ? cl.responsavel : '')].filter(Boolean);
  var dir = [cel('WhatsApp', cl.whatsapp), cel('Endereço de entrega', [cl.endereco, cl.cidade].filter(Boolean).join(' — '))].filter(Boolean);
  var blocoCli = {
    table: { widths: ['*'], body: [[{ fillColor: COR.nevoa, margin: [14, 10, 14, 4], columns: [{ width: '*', stack: esq.length ? esq : [cel('Cliente', '—')] }, { width: '*', stack: dir }], columnGap: 16 }]] },
    layout: 'noBorders', margin: [0, 16, 0, 0]
  };

  var corpo = [[
    { text: '#', style: 'th', alignment: 'center' }, { text: 'Produto', style: 'th' },
    { text: 'Qtd.', style: 'th', alignment: 'right' }, { text: 'Valor unit.', style: 'th', alignment: 'right' },
    { text: 'Subtotal', style: 'th', alignment: 'right' }
  ]];
  p.itens.forEach(function (it, i) {
    var f = i % 2 ? COR.zebra : null;
    corpo.push([
      { text: String(i + 1), style: 'td', alignment: 'center', color: COR.cinza, fillColor: f },
      { text: it.nome, style: 'td', bold: true, fillColor: f },
      { text: qtdTxt(it.qtd), style: 'td', alignment: 'right', fillColor: f },
      { text: brl(it.preco), style: 'td', alignment: 'right', fillColor: f },
      { text: brl((Number(it.qtd) || 0) * (Number(it.preco) || 0)), style: 'td', alignment: 'right', bold: true, fillColor: f }
    ]);
  });
  var tabItens = {
    table: { headerRows: 1, widths: [18, '*', 50, 64, 74], body: corpo },
    layout: {
      fillColor: function (r) { return r === 0 ? COR.azul : null; },
      hLineWidth: function (i, n) { return i === 0 || i === 1 ? 0 : (i === n.table.body.length ? 1 : 0.5); },
      hLineColor: function () { return COR.linha; }, vLineWidth: function () { return 0; },
      paddingTop: function () { return 5; }, paddingBottom: function () { return 5; }
    },
    margin: [0, 8, 0, 0]
  };

  var tot = [[{ text: 'Subtotal (' + t.unidades.toLocaleString('pt-BR') + ' unidades)', style: 'tl' }, { text: brl(t.sub), style: 'tv' }]];
  if (t.desc > 0) tot.push([{ text: 'Desconto' + (p.desconto.tipo === 'pct' ? ' (' + String(p.desconto.valor).replace('.', ',') + '%)' : ''), style: 'tl' }, { text: '− ' + brl(t.desc), style: 'tv', color: COR.verm }]);
  if (t.frete > 0) tot.push([{ text: 'Frete', style: 'tl' }, { text: brl(t.frete), style: 'tv' }]);
  tot.push([{ text: 'TOTAL', bold: true, color: '#fff', fontSize: 11, fillColor: COR.azul, margin: [10, 7, 6, 7] },
    { text: brl(t.total), bold: true, color: '#fff', fontSize: 13, alignment: 'right', fillColor: COR.azul, margin: [6, 5, 10, 5] }]);
  var blocoTot = { width: 244, table: { widths: ['*', 118], body: tot }, layout: 'noBorders' };

  var cond = [
    ['Tabela de preços', p.tabela === 'semNF' ? 'Preços sem nota fiscal' : 'Preços com nota fiscal'],
    ['Forma de pagamento', textoPagamento(p)],
    ['Frete', textoFrete(p)],
    ['Prazo de entrega', p.entrega || 'A combinar'],
    ['Validade da proposta', (p.validadeDias || 7) + ' dias (até ' + dataBR(validadeData(p)) + ')'],
    ['Pedido mínimo', (E.minimo || 12) + ' unidades por item']
  ].map(function (r) { return [{ text: r[0], style: 'rot' }, { text: r[1], style: 'val' }]; });
  var blocoCond = { width: '*', stack: [
    { text: 'Condições comerciais', style: 'h2' },
    { table: { widths: [92, '*'], body: cond }, layout: { hLineWidth: function (i, n) { return i === 0 || i === n.table.body.length ? 0 : 0.5; }, hLineColor: function () { return COR.linha; }, vLineWidth: function () { return 0; }, paddingTop: function () { return 4; }, paddingBottom: function () { return 4; }, paddingLeft: function () { return 0; } }, margin: [0, 6, 0, 0] }
  ] };

  var content = [cab, blocoCli, { text: 'Produtos', style: 'h2', margin: [0, 16, 0, 0] }, tabItens,
    { unbreakable: true, columns: [blocoCond, blocoTot], columnGap: 22, margin: [0, 14, 0, 0] }];
  if (String(p.obs || '').trim()) content.push({ unbreakable: true, margin: [0, 14, 0, 0], stack: [{ text: 'Observações', style: 'h2' }, { text: p.obs, style: 'val', margin: [0, 6, 0, 0], lineHeight: 1.3 }] });

  content.push({ unbreakable: true, margin: [0, 34, 0, 0], stack: [{ columns: [
    { width: '*', stack: [{ canvas: [{ type: 'line', x1: 0, y1: 0, x2: 220, y2: 0, lineWidth: 0.8, lineColor: COR.graf }] },
      { text: 'De acordo — ' + (cl.nome || cl.responsavel || 'Cliente'), style: 'ass', margin: [0, 5, 0, 0] }, { text: 'Data: ____/____/______', style: 'ass2' }] },
    { width: '*', alignment: 'right', stack: [{ canvas: [{ type: 'line', x1: 0, y1: 0, x2: 220, y2: 0, lineWidth: 0.8, lineColor: COR.graf }], alignment: 'right' },
      { text: (p.vendedor || 'Equipe comercial') + ' — GranRio', style: 'ass', margin: [0, 5, 0, 0] }, { text: 'WhatsApp ' + (E.whatsapp || ''), style: 'ass2' }] }
  ] }, { text: 'Para confirmar o pedido, responda esta proposta pelo WhatsApp ou devolva este documento assinado.', fontSize: 8.5, color: COR.cinza, alignment: 'center', margin: [0, 18, 0, 0] }] });

  return {
    pageSize: 'A4', pageMargins: [40, 46, 40, 58],
    info: { title: 'Proposta ' + p.numero + ' — GranRio', author: 'GranRio Vassouras' },
    background: function () { return { canvas: [
      { type: 'rect', x: 0, y: 0, w: 198.4, h: 7, color: COR.verm },
      { type: 'rect', x: 198.4, y: 0, w: 198.4, h: 7, color: '#ffffff' },
      { type: 'rect', x: 396.8, y: 0, w: 198.5, h: 7, color: COR.azul }] }; },
    footer: function (pg, n) { return { margin: [40, 16, 40, 0], stack: [
      { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 0.5, lineColor: COR.linha }] },
      { columns: [
        { text: [E.endereco, 'WhatsApp ' + E.whatsapp, E.email].filter(Boolean).join('  ·  '), fontSize: 7.5, color: COR.cinza, margin: [0, 6, 0, 0] },
        { text: 'Página ' + pg + ' de ' + n, fontSize: 7.5, color: COR.cinza, alignment: 'right', width: 70, margin: [0, 6, 0, 0] }] }] }; },
    content: content,
    defaultStyle: { font: 'Roboto', fontSize: 9.5, color: COR.graf },
    styles: {
      h2: { fontSize: 11.5, bold: true, color: COR.graf },
      rot: { fontSize: 8.5, color: COR.cinza }, val: { fontSize: 9.5, color: COR.graf },
      th: { fontSize: 8.5, bold: true, color: '#ffffff' }, td: { fontSize: 9 },
      tl: { fontSize: 9.5, color: COR.cinza, margin: [10, 4, 6, 4] }, tv: { fontSize: 10, bold: true, alignment: 'right', margin: [6, 4, 10, 4] },
      ass: { fontSize: 9, bold: true }, ass2: { fontSize: 8.5, color: COR.cinza, margin: [0, 2, 0, 0] }
    }
  };
}

</script>
<script>
/* ================= CONFIG ================= */
var qs = new URLSearchParams(location.search);
var CFG = {
  API: qs.get('api') || 'https://webhook.lv-mktdeconversa.com/webhook/plugin-proposta-granrio',
  KEY: qs.get('k') || '',
  ORIGENS: ['https://chat.leadvox.com.br', 'https://crm.leadvox.com.br']
};
var PASSOS = ['Cliente', 'Produtos', 'Condições', 'Enviar'];
var PAGAMENTOS = ['Pix', 'Dinheiro', 'Boleto', 'Cartão de crédito', 'Cartão de débito', 'Faturado'];
var PRAZOS = ['7 dias', '14 dias', '21 dias', '28 dias', '30 dias', '30/60 dias', '30/60/90 dias'];
var MSG1 = 'Olá, {nome}! Segue a proposta comercial nº {numero} da GranRio Vassouras, no valor de {total}, válida até {validade}.\n\nSe o arquivo não abrir, é só acessar: {link}';
var MSG2 = 'Qualquer dúvida sobre produtos, quantidades ou condições, estou à disposição. Pra confirmar o pedido, é só responder por aqui.';

/* ================= ESTADO ================= */
var S = { cat: [], grupos: [], empresa: {}, ticket: null, passo: 0, p: null, enviado: null, carregando: true, erro: '', busca: '', grupo: '' };

function novoNumero() {
  var d = new Date(), r = Math.random().toString(16).slice(2, 6).toUpperCase();
  return 'GR-' + String(d.getFullYear()).slice(2) + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0') + '-' + r;
}
function novaProposta() {
  return {
    numero: novoNumero(), data: new Date().toISOString(), validadeDias: 7, vendedor: '', oportunidade: true,
    cliente: { nome: '', doc: '', responsavel: '', whatsapp: '', endereco: '', cidade: '' },
    tabela: 'comNF', itens: [],
    desconto: { tipo: 'pct', valor: 0 }, frete: { tipo: 'combinar', valor: 0 },
    pagamento: ['Pix'], prazoFaturado: '28 dias', entrega: '', obs: '',
    msg1: MSG1, msg2: MSG2
  };
}
S.p = novaProposta();

function chaveRascunho() { return 'grprop_' + (S.ticket && S.ticket.id ? S.ticket.id : 'avulso'); }
function salvarRascunho() { try { localStorage.setItem(chaveRascunho(), JSON.stringify({ p: S.p, passo: S.passo })); } catch (e) {} }
function lerRascunho() { try { var r = localStorage.getItem(chaveRascunho()); return r ? JSON.parse(r) : null; } catch (e) { return null; } }
function apagarRascunho() { try { localStorage.removeItem(chaveRascunho()); } catch (e) {} }

function get(o, path) { return path.split('.').reduce(function (a, k) { return a == null ? a : a[k]; }, o); }
function set(o, path, v) { var ks = path.split('.'), last = ks.pop(); ks.reduce(function (a, k) { return a[k]; }, o)[last] = v; }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
function norm(s) { return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
function numBR(s) { if (typeof s === 'number') return s; s = String(s || '').replace(/[^\d,.-]/g, ''); if (s.indexOf(',') > -1) s = s.replace(/\./g, '').replace(',', '.'); var n = parseFloat(s); return isNaN(n) ? 0 : n; }
function fmt2(v) { return Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function telBonito(t) { var d = String(t || '').replace(/\D/g, ''); if (d.indexOf('55') === 0 && d.length > 11) d = d.slice(2);
  if (d.length === 11) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7);
  if (d.length === 10) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6); return t || ''; }
function telDestino(t) { var d = String(t || '').replace(/\D/g, ''); if (d.length === 10 || d.length === 11) d = '55' + d; return d; }
function toast(m) { var t = document.getElementById('toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toast._t); toast._t = setTimeout(function () { t.classList.remove('on'); }, 2600); }
function precoTab(c, tab) { return tab === 'semNF' ? c.semNF : c.comNF; }
function porId(id) { for (var i = 0; i < S.cat.length; i++) if (S.cat[i].id === id) return S.cat[i]; return null; }
function itemDe(id) { for (var i = 0; i < S.p.itens.length; i++) if (S.p.itens[i].id === id) return S.p.itens[i]; return null; }

/* ================= API ================= */
function api(body) {
  body.k = CFG.KEY;
  return fetch(CFG.API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(function (r) { return r.text().then(function (t) { var j; try { j = JSON.parse(t); } catch (e) { j = { ok: false, erro: 'Resposta inválida do servidor (' + r.status + ').' }; } if (!r.ok && j.ok !== false) j = { ok: false, erro: 'Servidor respondeu ' + r.status + '.' }; return j; }); });
}
function carregarCatalogo() {
  S.carregando = true; S.erro = ''; render();
  api({ rota: 'catalogo' }).then(function (j) {
    S.carregando = false;
    if (!j.ok) { S.erro = j.erro || 'Não foi possível carregar a tabela de preços.'; render(); return; }
    S.cat = j.catalogo || []; S.empresa = j.empresa || {};
    S.grupos = []; S.cat.forEach(function (c) { if (S.grupos.indexOf(c.grupo) === -1) S.grupos.push(c.grupo); });
    render();
  }).catch(function () { S.carregando = false; S.erro = 'Sem conexão com o servidor do plugin. Verifique se o workflow está ativo no N8N.'; render(); });
}

/* ================= TICKET (postMessage) ================= */
function campoPersonalizado(contact, nomes) {
  var cf = contact && (contact.customFields || contact.extraInfo);
  if (!cf) return '';
  var n = function (s) { return norm(s).replace(/[^a-z0-9]/g, ''); };
  var alvos = nomes.map(n);
  if (Array.isArray(cf)) { for (var i = 0; i < cf.length; i++) { var it = cf[i] || {}; if (alvos.indexOf(n(it.name || it.key || '')) > -1 && it.value) return String(it.value); } return ''; }
  for (var k in cf) if (alvos.indexOf(n(k)) > -1 && cf[k]) return String(cf[k]);
  return '';
}
function aplicarTicket(t) {
  if (!t || !t.id) return;
  if (S.ticket && S.ticket.id === t.id) { S.ticket = t; return; }
  S.ticket = t;
  var r = lerRascunho();
  if (r && r.p) { S.p = r.p; S.passo = r.passo || 0; S.enviado = null; render(); return; }
  S.p = novaProposta(); S.passo = 0; S.enviado = null;
  var c = t.contact || {}, cl = S.p.cliente;
  cl.responsavel = c.name || '';
  cl.whatsapp = telBonito(c.number || '');
  cl.nome = campoPersonalizado(c, ['Nome Empresa.:', 'Nome Empresa', 'Empresa', 'Razão Social']) || c.company || '';
  cl.doc = campoPersonalizado(c, ['CNPJ', 'CPF', 'CNPJ/CPF']);
  cl.endereco = campoPersonalizado(c, ['Endereço', 'Endereco', 'Endereço de entrega']);
  cl.cidade = campoPersonalizado(c, ['Cidade', 'Praça/UF', 'Bairro']) || [c.cidade, c.estado].filter(Boolean).join(' / ');
  S.p.vendedor = (t.user && t.user.name) || '';
  render();
}
window.addEventListener('message', function (ev) {
  if (CFG.ORIGENS.indexOf(ev.origin) === -1) return;
  var m = ev.data; if (typeof m === 'string') { try { m = JSON.parse(m); } catch (e) { return; } }
  if (m && m.type === 'DEFAULT_DATA' && m.data && m.data.ticket) aplicarTicket(m.data.ticket);
});

/* ================= RENDER ================= */
var app = document.getElementById('app');
var LOGO_TOPO = 'data:image/png;base64,';

function render() {
  if (!CFG.KEY) { app.innerHTML = '<div class="center"><h2>Falta a chave de acesso</h2><p>Abra o plugin pela URL completa cadastrada na LeadVox, com <b>?k=</b> no final.</p></div>'; return; }
  if (S.carregando) { app.innerHTML = '<div class="center"><p>Carregando a tabela de preços…</p></div>'; return; }
  if (S.erro) { app.innerHTML = '<div class="center"><h2>Não deu pra abrir</h2><p>' + esc(S.erro) + '</p><button class="b pri" onclick="carregarCatalogo()">Tentar de novo</button></div>'; return; }
  var cl = S.p.cliente;
  var quem = (cl.nome || cl.responsavel) ? '<strong>' + esc(cl.nome || cl.responsavel) + '</strong>' + (cl.nome && cl.responsavel ? ' · ' + esc(cl.responsavel) : '') : 'Nenhum cliente carregado do ticket';
  var passos = PASSOS.map(function (n, i) {
    return '<button class="step' + (i === S.passo ? ' on' : '') + (i < S.passo ? ' ok' : '') + '" data-passo="' + i + '"><i>' + (i < S.passo ? '✓' : i + 1) + '</i>' + n + '</button>';
  }).join('');
  app.innerHTML =
    '<header class="top"><div class="tri"><i></i><i></i><i></i></div><div class="top-row"><span class="brand"><img src="' + LOGO_TOPO + '" alt=""><span><b>Gran</b><span>Rio</span></span> <small>proposta</small></span><span class="num">' + esc(S.p.numero) + '</span></div>' +
    '<div class="who">' + quem + '</div>' + (S.enviado ? '' : '<nav class="steps">' + passos + '</nav>') + '</header>' +
    '<main id="main">' + (S.enviado ? telaEnviado() : [telaCliente, telaProdutos, telaCondicoes, telaEnviar][S.passo]()) + '</main>' +
    (S.enviado ? '' : barra());
  ligar();
  atualizarTotais();
}

function campo(rot, path, x) {
  x = x || {};
  var v = get(S.p, path);
  var tag = x.area ? '<textarea class="i" data-k="' + path + '" rows="' + (x.rows || 3) + '" placeholder="' + esc(x.ph || '') + '">' + esc(v) + '</textarea>'
    : '<input class="i" data-k="' + path + '" value="' + esc(v) + '" placeholder="' + esc(x.ph || '') + '"' + (x.type ? ' type="' + x.type + '"' : '') + (x.im ? ' inputmode="' + x.im + '"' : '') + ' />';
  return '<div class="fld"><label>' + rot + '</label>' + tag + (x.hint ? '<div class="hint">' + x.hint + '</div>' : '') + '</div>';
}

function telaCliente() {
  return '<h2 class="t">Cliente</h2><p class="sub">Os dados do ticket já vêm preenchidos. Complete o que faltar.</p>' +
    campo('Cliente (empresa ou nome)', 'cliente.nome', { ph: 'Ex.: Mercado Bom Preço' }) +
    '<div class="row">' + campo('CNPJ / CPF', 'cliente.doc', { ph: 'Opcional', im: 'numeric' }) + campo('Responsável', 'cliente.responsavel', { ph: 'Quem vai receber' }) + '</div>' +
    campo('WhatsApp do cliente', 'cliente.whatsapp', { ph: '(21) 90000-0000', type: 'tel', hint: 'A proposta vai para este número.' }) +
    campo('Endereço de entrega', 'cliente.endereco', { ph: 'Rua, número e bairro' }) +
    campo('Cidade / UF', 'cliente.cidade', { ph: 'Ex.: São João de Meriti / RJ' }) +
    campo('Vendedor', 'vendedor', { ph: 'Seu nome', hint: 'Aparece na assinatura da proposta.' });
}

function linhaSel(it, idx) {
  var c = it.id ? porId(it.id) : null, min = (c && c.min) || S.empresa.minimo || 12;
  var alt = c && Math.abs(Number(it.preco) - precoTab(c, S.p.tabela)) > 0.004;
  return '<div class="sel-it" data-idx="' + idx + '">' +
    '<div class="nm">' + (it.id ? esc(it.nome) : '<input class="i" data-it="nome" data-idx="' + idx + '" value="' + esc(it.nome) + '" placeholder="Nome do produto" />') + '</div>' +
    '<button class="x" data-rm="' + idx + '" aria-label="Remover ' + esc(it.nome) + '">×</button>' +
    '<div class="ctl"><div class="stp"><button data-q="-" data-idx="' + idx + '" aria-label="Menos">−</button><input data-it="qtd" data-idx="' + idx + '" inputmode="numeric" value="' + esc(it.qtd) + '" aria-label="Quantidade" /><button data-q="+" data-idx="' + idx + '" aria-label="Mais">+</button></div>' +
    '<div class="pr' + (alt ? ' alt' : '') + '"><span>R$</span><input data-it="preco" data-idx="' + idx + '" inputmode="decimal" value="' + fmt2(it.preco) + '" aria-label="Valor unitário" /></div>' +
    '<div class="stt" data-sub="' + idx + '"></div></div>' +
    '<div class="warn" data-warn="' + idx + '">' + (Number(it.qtd) < min ? 'Abaixo do mínimo de ' + min + ' unidades.' : '') + (alt ? (Number(it.qtd) < min ? ' ' : '') + 'Preço fora da tabela (' + 'R$ ' + fmt2(precoTab(c, S.p.tabela)) + ').' : '') + '</div>' +
    '</div>';
}

function telaProdutos() {
  var p = S.p;
  var sel = p.itens.length ? p.itens.map(linhaSel).join('') : '<div class="empty">Nenhum produto ainda. Adicione pela lista abaixo.</div>';
  var gch = '<button class="chip' + (!S.grupo ? ' on' : '') + '" data-g="">Todos</button>' + S.grupos.map(function (g) { return '<button class="chip' + (S.grupo === g ? ' on' : '') + '" data-g="' + esc(g) + '">' + esc(g) + '</button>'; }).join('');
  return '<h2 class="t">Produtos</h2><p class="sub">Escolha a tabela, adicione os produtos e ajuste quantidades. Mínimo de ' + (S.empresa.minimo || 12) + ' unidades por item.</p>' +
    '<div class="fld"><span class="lbl">Tabela de preços</span><div class="seg" role="group"><button data-tab="comNF" class="' + (p.tabela === 'comNF' ? 'on' : '') + '">Com N.F.</button><button data-tab="semNF" class="' + (p.tabela === 'semNF' ? 'on' : '') + '">Sem N.F.</button></div></div>' +
    '<div class="card"><h3>Na proposta <small>' + p.itens.length + (p.itens.length === 1 ? ' item' : ' itens') + '</small></h3>' + sel +
    '<button class="btn-sm" id="avulso">+ Item fora da tabela</button></div>' +
    '<div class="busca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input class="i" id="busca" placeholder="Buscar produto" value="' + esc(S.busca) + '" /></div>' +
    '<div class="chips scroll">' + gch + '</div>' +
    '<div id="lista">' + listaCatalogo() + '</div>';
}
function listaCatalogo() {
  var q = norm(S.busca).trim(), html = '', ultimo = '';
  var vis = S.cat.filter(function (c) { return (!S.grupo || c.grupo === S.grupo) && (!q || norm(c.nome + ' ' + c.grupo).indexOf(q) > -1); });
  if (!vis.length) return '<div class="empty">Nenhum produto encontrado.</div>';
  vis.forEach(function (c) {
    if (c.grupo !== ultimo) { html += '<div class="grp">' + esc(c.grupo) + '</div>'; ultimo = c.grupo; }
    var it = itemDe(c.id);
    html += '<div class="prod"><div class="inf"><b>' + esc(c.nome) + '</b><span>R$ ' + fmt2(precoTab(c, S.p.tabela)) + ' / un. · mín. ' + (c.min || 12) + '</span></div>' +
      '<button class="add' + (it ? ' in' : '') + '" data-add="' + c.id + '">' + (it ? '✓ ' + it.qtd + ' un.' : '+ Adicionar') + '</button></div>';
  });
  return html;
}

function telaCondicoes() {
  var p = S.p;
  var pg = PAGAMENTOS.map(function (f) { return '<button class="chip' + (p.pagamento.indexOf(f) > -1 ? ' on' : '') + '" data-pg="' + f + '">' + f + '</button>'; }).join('');
  var pz = PRAZOS.map(function (x) { return '<option' + (p.prazoFaturado === x ? ' selected' : '') + '>' + x + '</option>'; }).join('');
  var fr = [['combinar', 'A combinar'], ['cif', 'Grátis (CIF)'], ['retirada', 'Retirada'], ['cobrado', 'Cobrar frete']];
  return '<h2 class="t">Condições</h2><p class="sub">Pagamento, frete e prazos que entram no PDF.</p>' +
    '<div class="fld"><span class="lbl">Forma de pagamento</span><div class="chips">' + pg + '</div></div>' +
    (p.pagamento.indexOf('Faturado') > -1 ? '<div class="fld"><label>Prazo do faturado</label><select class="i" data-k="prazoFaturado">' + pz + '</select></div>' : '') +
    '<div class="fld"><span class="lbl">Desconto</span><div class="row"><div class="seg"><button data-dt="pct" class="' + (p.desconto.tipo === 'pct' ? 'on' : '') + '">%</button><button data-dt="rs" class="' + (p.desconto.tipo === 'rs' ? 'on' : '') + '">R$</button></div>' +
    '<input class="i" data-num="desconto.valor" inputmode="decimal" value="' + (p.desconto.valor ? fmt2(p.desconto.valor) : '') + '" placeholder="0" /></div></div>' +
    '<div class="fld"><span class="lbl">Frete</span><div class="seg">' + fr.map(function (f) { return '<button data-fr="' + f[0] + '" class="' + (p.frete.tipo === f[0] ? 'on' : '') + '">' + f[1] + '</button>'; }).join('') + '</div></div>' +
    (p.frete.tipo === 'cobrado' ? '<div class="fld"><label>Valor do frete (R$)</label><input class="i" data-num="frete.valor" inputmode="decimal" value="' + (p.frete.valor ? fmt2(p.frete.valor) : '') + '" placeholder="0,00" /></div>' : '') +
    '<div class="row">' + campo('Prazo de entrega', 'entrega', { ph: 'A combinar' }) +
    '<div class="fld"><label>Validade (dias)</label><input class="i" data-num="validadeDias" inputmode="numeric" value="' + esc(p.validadeDias) + '" /></div></div>' +
    campo('Observações', 'obs', { area: true, rows: 3, ph: 'Aparece no PDF. Opcional.' });
}

function resumo() {
  var t = calcular(S.p);
  return '<div class="card resumo"><h3>Resumo</h3>' +
    '<div><span>Itens</span><b>' + S.p.itens.length + ' produtos · ' + t.unidades.toLocaleString('pt-BR') + ' un.</b></div>' +
    '<div><span>Subtotal</span><b>' + brl(t.sub) + '</b></div>' +
    (t.desc ? '<div><span>Desconto</span><b style="color:var(--verm)">− ' + brl(t.desc) + '</b></div>' : '') +
    (t.frete ? '<div><span>Frete</span><b>' + brl(t.frete) + '</b></div>' : '') +
    '<div><span>Pagamento</span><b>' + esc(textoPagamento(S.p)) + '</b></div>' +
    '<div class="big"><span>Total</span><b>' + brl(t.total) + '</b></div></div>';
}
function telaEnviar() {
  var p = S.p, pend = pendencias();
  return '<h2 class="t">Enviar</h2><p class="sub">Confira o PDF e as mensagens. Vai tudo pelo WhatsApp do cliente.</p>' +
    (pend.length ? '<div class="aviso">' + pend.map(esc).join('<br>') + '</div>' : '') + resumo() +
    '<button class="b sec" id="prev" style="width:100%;margin-bottom:14px">Ver o PDF da proposta</button>' +
    campo('Enviar para (WhatsApp)', 'cliente.whatsapp', { type: 'tel' }) +
    campo('Mensagem 1 (vai logo depois do PDF)', 'msg1', { area: true, rows: 6, hint: 'Pode usar {nome}, {numero}, {total}, {validade} e {link} (o link do PDF).' }) +
    campo('Mensagem 2', 'msg2', { area: true, rows: 3, hint: 'Deixe em branco para não mandar.' }) +
    '<label class="chk"><input type="checkbox" id="opp"' + (p.oportunidade ? ' checked' : '') + ' /> <span>Criar oportunidade no funil com o valor total</span></label>';
}
function telaEnviado() {
  var e = S.enviado;
  return '<div class="okbig">✓</div><h2 class="t" style="text-align:center">Proposta enviada</h2>' +
    '<p class="sub" style="text-align:center">Nº ' + esc(e.numero) + ' · ' + brl(e.total) + '</p>' +
    '<ul class="st">' + (e.status || []).map(function (s) { return '<li class="' + (s.ok ? 'ok' : 'no') + '">' + esc(s.texto) + '</li>'; }).join('') + '</ul>' +
    (e.pdfUrl ? '<p class="lbl">Link do PDF</p><p class="lnk"><a href="' + esc(e.pdfUrl) + '" target="_blank" rel="noopener">' + esc(e.pdfUrl) + '</a></p>' : '') +
    '<button class="b pri" id="nova" style="width:100%;margin-top:18px">Nova proposta</button>';
}
function barra() {
  var ult = S.passo === PASSOS.length - 1;
  return '<div class="bar"><div class="tot"><span id="bUn"></span><span>Total <b id="bTot"></b></span></div><div class="acts">' +
    (S.passo > 0 ? '<button class="b sec" id="voltar">Voltar</button>' : '') +
    (ult ? '<button class="b wpp" id="enviar">Enviar proposta no WhatsApp</button>' : '<button class="b pri" id="avancar">Avançar</button>') + '</div></div>';
}

function pendencias() {
  var p = S.p, out = [];
  if (!p.cliente.nome && !p.cliente.responsavel) out.push('Informe o nome do cliente.');
  var tel = telDestino(p.cliente.whatsapp); if (tel.length < 12 || tel.length > 13) out.push('Informe o WhatsApp do cliente com DDD.');
  if (!p.itens.length) out.push('Adicione pelo menos um produto.');
  p.itens.forEach(function (it) { if (!String(it.nome).trim()) out.push('Tem item sem nome.'); if (!(Number(it.qtd) > 0)) out.push('"' + it.nome + '" está sem quantidade.'); if (!(Number(it.preco) > 0)) out.push('"' + (it.nome || 'Item') + '" está sem preço.'); });
  return out;
}

function atualizarTotais() {
  var t = calcular(S.p);
  var bt = document.getElementById('bTot'), bu = document.getElementById('bUn');
  if (bt) bt.textContent = brl(t.total);
  if (bu) bu.textContent = S.p.itens.length ? S.p.itens.length + (S.p.itens.length === 1 ? ' item · ' : ' itens · ') + t.unidades.toLocaleString('pt-BR') + ' un.' : 'Nenhum item';
  S.p.itens.forEach(function (it, i) {
    var el = document.querySelector('[data-sub="' + i + '"]'); if (el) el.textContent = brl((Number(it.qtd) || 0) * (Number(it.preco) || 0));
  });
}

/* ================= AÇÕES ================= */
function adicionar(id) {
  var c = porId(id); if (!c) return;
  var it = itemDe(id);
  if (it) it.qtd = Number(it.qtd) + (c.min || 12);
  else S.p.itens.push({ id: c.id, nome: c.nome, qtd: c.min || 12, preco: precoTab(c, S.p.tabela) });
  salvarRascunho();
}
function trocarTabela(tab) {
  var velha = S.p.tabela; if (velha === tab) return;
  S.p.itens.forEach(function (it) { var c = it.id && porId(it.id); if (c && Math.abs(Number(it.preco) - precoTab(c, velha)) < 0.005) it.preco = precoTab(c, tab); });
  S.p.tabela = tab;
}
function ir(n) { S.passo = Math.max(0, Math.min(PASSOS.length - 1, n)); salvarRascunho(); render(); window.scrollTo(0, 0); }

function ligar() {
  app.querySelectorAll('[data-passo]').forEach(function (b) { b.onclick = function () { ir(+b.dataset.passo); }; });
  app.querySelectorAll('[data-k]').forEach(function (el) {
    var h = function () { set(S.p, el.dataset.k, el.value); salvarRascunho(); if (el.dataset.k.indexOf('cliente.') === 0) atualizarQuem(); };
    el.addEventListener('input', h); el.addEventListener('change', h);
  });
  app.querySelectorAll('[data-num]').forEach(function (el) {
    el.addEventListener('input', function () { set(S.p, el.dataset.num, numBR(el.value)); salvarRascunho(); atualizarTotais(); });
  });
  var v = document.getElementById('voltar'); if (v) v.onclick = function () { ir(S.passo - 1); };
  var a = document.getElementById('avancar'); if (a) a.onclick = function () {
    if (S.passo === 1 && !S.p.itens.length) { toast('Adicione pelo menos um produto.'); return; }
    ir(S.passo + 1);
  };
  // produtos
  app.querySelectorAll('[data-tab]').forEach(function (b) { b.onclick = function () { trocarTabela(b.dataset.tab); salvarRascunho(); render(); }; });
  app.querySelectorAll('[data-g]').forEach(function (b) { b.onclick = function () { S.grupo = b.dataset.g; render(); }; });
  var bu = document.getElementById('busca'); if (bu) bu.addEventListener('input', function () { S.busca = bu.value; document.getElementById('lista').innerHTML = listaCatalogo(); ligarLista(); });
  ligarLista();
  app.querySelectorAll('[data-rm]').forEach(function (b) { b.onclick = function () { S.p.itens.splice(+b.dataset.rm, 1); salvarRascunho(); render(); }; });
  app.querySelectorAll('[data-q]').forEach(function (b) { b.onclick = function () {
    var it = S.p.itens[+b.dataset.idx], c = it.id && porId(it.id), passo = (c && c.min) || 12;
    var q = Number(it.qtd) || 0; q = b.dataset.q === '+' ? q + passo : Math.max(passo, q - passo); it.qtd = q; salvarRascunho(); render();
  }; });
  app.querySelectorAll('[data-it]').forEach(function (el) {
    el.addEventListener('input', function () {
      var it = S.p.itens[+el.dataset.idx], k = el.dataset.it;
      if (k === 'nome') it.nome = el.value; else if (k === 'qtd') it.qtd = parseInt(el.value.replace(/\D/g, ''), 10) || 0; else it.preco = numBR(el.value);
      salvarRascunho(); atualizarTotais(); atualizarAvisoItem(+el.dataset.idx);
    });
    if (el.dataset.it === 'preco') el.addEventListener('blur', function () { el.value = fmt2(S.p.itens[+el.dataset.idx].preco); });
  });
  var av = document.getElementById('avulso'); if (av) av.onclick = function () { S.p.itens.push({ id: null, nome: '', qtd: 12, preco: 0 }); salvarRascunho(); render();
    var ins = app.querySelectorAll('[data-it="nome"]'); if (ins.length) ins[ins.length - 1].focus(); };
  // condições
  app.querySelectorAll('[data-pg]').forEach(function (b) { b.onclick = function () {
    var f = b.dataset.pg, i = S.p.pagamento.indexOf(f); if (i > -1) S.p.pagamento.splice(i, 1); else S.p.pagamento.push(f);
    S.p.pagamento.sort(function (x, y) { return PAGAMENTOS.indexOf(x) - PAGAMENTOS.indexOf(y); }); salvarRascunho(); render(); }; });
  app.querySelectorAll('[data-dt]').forEach(function (b) { b.onclick = function () { S.p.desconto.tipo = b.dataset.dt; salvarRascunho(); render(); }; });
  app.querySelectorAll('[data-fr]').forEach(function (b) { b.onclick = function () { S.p.frete.tipo = b.dataset.fr; salvarRascunho(); render(); }; });
  // enviar
  var pv = document.getElementById('prev'); if (pv) pv.onclick = abrirPrevia;
  var op = document.getElementById('opp'); if (op) op.onchange = function () { S.p.oportunidade = op.checked; salvarRascunho(); };
  var en = document.getElementById('enviar'); if (en) en.onclick = enviar;
  var nv = document.getElementById('nova'); if (nv) nv.onclick = function () { apagarRascunho(); var cl = S.p.cliente, vend = S.p.vendedor; S.p = novaProposta(); S.p.cliente = cl; S.p.vendedor = vend; S.enviado = null; S.passo = 0; render(); };
}
function ligarLista() {
  app.querySelectorAll('[data-add]').forEach(function (b) { b.onclick = function () {
    var ja = itemDe(b.dataset.add); adicionar(b.dataset.add);
    toast(ja ? '+' + (porId(b.dataset.add).min || 12) + ' un. de ' + ja.nome : 'Adicionado: ' + porId(b.dataset.add).nome);
    var y = window.scrollY; render(); window.scrollTo(0, y);
  }; });
}
function atualizarAvisoItem(i) {
  var it = S.p.itens[i], c = it.id && porId(it.id), min = (c && c.min) || 12, w = document.querySelector('[data-warn="' + i + '"]'); if (!w) return;
  var alt = c && Math.abs(Number(it.preco) - precoTab(c, S.p.tabela)) > 0.004, msg = [];
  if (Number(it.qtd) < min) msg.push('Abaixo do mínimo de ' + min + ' unidades.');
  if (alt) msg.push('Preço fora da tabela (R$ ' + fmt2(precoTab(c, S.p.tabela)) + ').');
  w.textContent = msg.join(' ');
  var pr = document.querySelector('[data-it="preco"][data-idx="' + i + '"]'); if (pr) pr.parentNode.classList.toggle('alt', !!alt);
}
function atualizarQuem() {
  var cl = S.p.cliente, w = app.querySelector('.who'); if (!w) return;
  w.innerHTML = (cl.nome || cl.responsavel) ? '<strong>' + esc(cl.nome || cl.responsavel) + '</strong>' + (cl.nome && cl.responsavel ? ' · ' + esc(cl.responsavel) : '') : 'Nenhum cliente carregado do ticket';
}

/* ================= PDF ================= */
function docAtual() { return montarDoc(S.p, S.empresa, typeof LOGO_PDF !== 'undefined' ? LOGO_PDF : null); }
function nomeArquivo() { var n = (S.p.cliente.nome || S.p.cliente.responsavel || 'Cliente').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
  return 'Proposta-GranRio-' + S.p.numero + '-' + n + '.pdf'; }
var urlPrevia = null;
function abrirPrevia() {
  if (!window.pdfMake) { toast('O gerador de PDF ainda está carregando.'); return; }
  pdfMake.createPdf(docAtual()).getBlob(function (b) {
    if (urlPrevia) URL.revokeObjectURL(urlPrevia);
    urlPrevia = URL.createObjectURL(b);
    document.getElementById('mFrame').src = urlPrevia;
    document.getElementById('mod').classList.add('on');
  });
}
document.getElementById('mFechar').onclick = function () { document.getElementById('mod').classList.remove('on'); };
document.getElementById('mBaixar').onclick = function () { pdfMake.createPdf(docAtual()).download(nomeArquivo()); };

function preencher(tpl, t) {
  var cl = S.p.cliente, primeiro = String(cl.responsavel || cl.nome || '').trim().split(/\s+/)[0] || '';
  return String(tpl || '').replace(/\{nome\}/g, primeiro).replace(/\{numero\}/g, S.p.numero)
    .replace(/\{total\}/g, brl(t.total)).replace(/\{validade\}/g, dataBR(validadeData(S.p)));
}
function enviar() {
  var pend = pendencias(); if (pend.length) { toast(pend[0]); render(); return; }
  if (!window.pdfMake) { toast('O gerador de PDF ainda está carregando.'); return; }
  var btn = document.getElementById('enviar'); btn.disabled = true; btn.textContent = 'Gerando PDF…';
  var t = calcular(S.p), p = S.p;
  pdfMake.createPdf(docAtual()).getBase64(function (b64) {
    btn.textContent = 'Enviando…';
    api({
      rota: 'enviar', pdfBase64: b64, fileName: nomeArquivo(), numero: p.numero,
      telefone: telDestino(p.cliente.whatsapp), cliente: p.cliente.nome || p.cliente.responsavel, responsavel: p.cliente.responsavel,
      itens: p.itens.map(function (it) { return it.qtd + ' un. ' + it.nome + ' × R$ ' + fmt2(it.preco); }),
      tabela: p.tabela === 'semNF' ? 'Sem N.F.' : 'Com N.F.', pagamento: textoPagamento(p), frete: textoFrete(p),
      subtotal: t.sub, desconto: t.desc, valorFrete: t.frete, total: t.total, validade: dataBR(validadeData(p)),
      mensagem1: preencher(p.msg1, t), mensagem2: preencher(p.msg2, t), vendedor: p.vendedor,
      ticketId: S.ticket && S.ticket.id, contactId: S.ticket && S.ticket.contact && S.ticket.contact.id,
      userId: S.ticket && S.ticket.user && S.ticket.user.id, criarOportunidade: !!p.oportunidade
    }).then(function (j) {
      if (!j.ok) {
        btn.disabled = false; btn.textContent = 'Enviar proposta no WhatsApp';
        var main = document.getElementById('main'), av = document.createElement('div'); av.className = 'aviso';
        av.innerHTML = '<b>' + esc(j.erro || 'O envio falhou.') + '</b>' + (j.status ? '<ul class="st">' + j.status.map(function (s) { return '<li class="' + (s.ok ? 'ok' : 'no') + '">' + esc(s.texto) + '</li>'; }).join('') + '</ul>' : '');
        main.insertBefore(av, main.firstChild); window.scrollTo(0, 0); return;
      }
      S.enviado = { numero: p.numero, total: t.total, status: j.status, pdfUrl: j.pdfUrl };
      apagarRascunho(); render(); window.scrollTo(0, 0);
    }).catch(function () { btn.disabled = false; btn.textContent = 'Enviar proposta no WhatsApp'; toast('Sem conexão com o servidor. Tente de novo.'); });
  });
}

render();
if (CFG.KEY) carregarCatalogo();
setTimeout(function () { if (!S.ticket && !S.carregando) { var r = lerRascunho(); if (r && r.p) { S.p = r.p; S.passo = r.passo || 0; render(); } } }, 1800);
</script>
</body>
